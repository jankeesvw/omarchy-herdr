#!/bin/bash
# herdr-sessions — what the herdr widget needs to know, as JSON.
#
# Herdr runs one server per named session. `herdr session list` knows which
# ones exist, and each running server answers `api snapshot` with the agents
# and workspaces inside it. This script joins the two, adds the Hyprland
# window that is showing each session, and prints one object the panel can
# draw without any further work.
#
#   list          every session, running or stopped
#   open <name>   focus the window showing that session, or open one
#   focus <name> <pane>
#                 the same, but land on one agent's pane inside it
#   kill <name>   signal the session's server until it is gone
#   delete <name> remove a stopped session's directory
#   demo on|off   invented sessions instead of yours, for screenshots
#
# Demo mode exists so a screenshot never carries real project names or agent
# titles, and so it looks the same in a year. Every write is a no-op while it
# is on, so a click during a shoot cannot kill a real server.
#
# Agent states are herdr's own: `blocked` means it recognised an approval or
# question on screen, so that agent is waiting on you. `done` is idle after
# background work you have not looked at yet - the tab goes back to `idle` the
# moment it is focused. Those two are the ones worth noticing.
#
# Every value below the session name comes from a snapshot: workspace labels
# are directory names, agent titles are whatever an agent wrote there. They
# are printed as JSON strings and drawn as plain text, never handed to a
# shell.

set -euo pipefail
umask 077

readonly APP_ID=org.omarchy.herdr
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-herdr"
readonly DEMO_FILE="$CACHE_DIR/demo"

die() {
  printf '{"ok":false,"error":%s,"sessions":[]}\n' "$(json_string "$1")"
  exit 0
}

# JSON-encode with jq, so a session name or window title with a quote, a
# backslash or a newline in it cannot break the object the panel parses.
json_string() {
  printf '%s' "${1-}" | jq -Rs .
}

# Session names come from `herdr session list`, but they also arrive back as
# an argument from the panel, so they are checked before they reach a command
# line. A name shaped like anything else means the other side is not what we
# think it is: refuse it rather than tidy it up.
valid_session_name() {
  [[ "${1-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

# Pane ids are herdr's own - "w1:p2" - and come back from the panel the same
# way session names do, so they get the same treatment: checked for shape
# before they reach a command line, refused rather than repaired.
valid_pane_id() {
  [[ "${1-}" =~ ^[A-Za-z0-9_-]{1,32}:[A-Za-z0-9_-]{1,32}$ ]]
}

# A directory someone else can write to is a directory that can hand this
# script a symlink on the name it is about to write. Refuse rather than repair
# what is not ours, and repair the rest unconditionally: a mode set once says
# nothing about what a previous version left inside.
private_dir() {
  local dir="$1" owner
  mkdir -p -m 700 -- "$dir" 2>/dev/null
  [[ -d $dir && ! -L $dir ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ $owner == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1
  find "$dir" -mindepth 1 -maxdepth 1 ! -type f -exec rm -rf -- {} + 2>/dev/null
  find "$dir" -mindepth 1 -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null
  return 0
}

readable_file() {
  [[ -f "$1" && ! -L "$1" ]]
}

demo_on() {
  readable_file "$DEMO_FILE"
}

cmd_demo() {
  case "${1-}" in
    on)
      private_dir "$CACHE_DIR" || die "could not use the cache directory"
      : > "$DEMO_FILE"
      chmod 600 -- "$DEMO_FILE" 2>/dev/null || true
      printf '{"ok":true,"demo":true}\n'
      ;;
    off)
      rm -f -- "$DEMO_FILE"
      printf '{"ok":true,"demo":false}\n'
      ;;
    *) die "demo takes on or off" ;;
  esac
}

# Invented, but modelled on real work rather than made into a joke: a session
# waiting on an approval, one that finished while nobody was looking, one still
# going, and one whose server has been left behind.
demo_list() {
  cat <<'DEMO'
{"ok":true,"error":"","sessions":[
{"name":"default","isDefault":true,"running":true,"version":"0.8.2","agents":2,"working":1,"blocked":0,"idle":1,"done":0,"workspaces":2,"projects":["checkout-service","design-tokens"],"agentList":[{"title":"Rewrite the receipt formatter","status":"working","pane":"w1:p1","seq":11},{"title":"Token names for the new palette","status":"idle","pane":"w2:p1","seq":9}],"windowAddress":"0x1"},
{"name":"3","isDefault":false,"running":true,"version":"0.8.2","agents":1,"working":0,"blocked":1,"idle":0,"done":0,"workspaces":1,"projects":["billing-api"],"agentList":[{"title":"Drop the legacy invoice table","status":"blocked","pane":"w1:p1","seq":14}],"windowAddress":"0x2"},
{"name":"5","isDefault":false,"running":true,"version":"0.8.2","agents":2,"working":0,"blocked":0,"idle":0,"done":2,"workspaces":1,"projects":["docs-site"],"agentList":[{"title":"Upgrade the search index","status":"done","pane":"w1:p1","seq":12},{"title":"Fix the broken anchor links","status":"done","pane":"w1:p2","seq":13}],"windowAddress":""},
{"name":"9","isDefault":false,"running":false,"version":"","agents":0,"working":0,"blocked":0,"idle":0,"done":0,"workspaces":0,"projects":[],"agentList":[],"windowAddress":""}
],"running":3,"agents":5,"blocked":1,"done":2,"working":1}
DEMO
}

require_tools() {
  local tool
  for tool in herdr jq; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"
  done
}

# ---------------------------------------------------------------- windows

# One step up the process tree. Read from /proc rather than kept in an array
# of every process on the machine: only the handful of herdr clients are ever
# walked, and each walk is a few reads.
#
# The comm field is in brackets and can hold spaces, so the line is cut after
# the closing bracket before splitting: what follows is state, then ppid.
parent_pid() {
  local line rest
  { read -r line < "/proc/$1/stat"; } 2>/dev/null || return 1
  rest=${line#*") "}
  # shellcheck disable=SC2086
  set -- $rest
  [[ ${2-} =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$2"
}

# Which Hyprland window is showing which session.
#
# The launcher puts `herdr --session <name>` on the terminal's own command
# line, so most windows are recognised from that alone. A herdr started by
# hand inside an existing terminal is not, so the client processes are walked
# up to their window instead: a process named exactly `herdr` is the client,
# `herdr server` is not.
#
# Prints "session<TAB>address<TAB>workspace" per line. Sessions without a
# window are absent.
window_map() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  local clients
  clients=$(hyprctl clients -j 2>/dev/null) || return 0
  [[ -n $clients ]] || return 0

  declare -A window_of_pid=()
  local pid address workspace
  while IFS=$'\t' read -r pid address workspace; do
    [[ -n $pid && -n $address ]] || continue
    window_of_pid[$pid]=$address$'\t'$workspace
  done < <(printf '%s' "$clients" |
    jq -r '.[] | select(.pid > 0)
           | "\(.pid)\t\(.address)\t\(.workspace.name // "")"' 2>/dev/null)

  ((${#window_of_pid[@]})) || return 0

  # Only the herdr processes are read in. Reading every command line on the
  # machine into an array cost more than every other step in this script put
  # together, and all but a handful of those lines never mention herdr.
  declare -A args_of=()
  while read -r pid args; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    args_of[$pid]=$args
  done < <(ps -eo pid=,args= 2>/dev/null | grep -E 'her[d]r')

  declare -A seen=()

  emit() {
    local session="$1" window="$2"
    [[ -n ${seen[$session]-} ]] && return 0
    seen[$session]=1
    printf '%s\t%s\n' "$session" "$window"
  }

  # Read a session name out of a command line that runs herdr. The answer
  # comes back in $found_session rather than on stdout: a command
  # substitution forks a subshell, and this is called once per process on the
  # machine. Through a `$()` it cost a third of a second per refresh.
  local found_session=""
  session_in_args() {
    found_session=""
    local -a words
    read -r -a words <<<"${1-}"
    local i j name
    for ((i = 0; i < ${#words[@]}; i++)); do
      [[ ${words[i]##*/} == herdr ]] || continue
      # `herdr server` is the background process, not a window's client.
      [[ ${words[i + 1]-} == server ]] && return 1
      name=default
      for ((j = i + 1; j < ${#words[@]}; j++)); do
        [[ ${words[j]} == --session ]] || continue
        name=${words[j + 1]-}
        break
      done
      valid_session_name "$name" || return 1
      found_session=$name
      return 0
    done
    return 1
  }

  # The terminal's own command line first: that is how the launcher starts one.
  for pid in "${!window_of_pid[@]}"; do
    session_in_args "${args_of[$pid]-}" || continue
    emit "$found_session" "${window_of_pid[$pid]}"
  done

  # Then anything started by hand, walked up from the client to its window.
  local ancestor hops
  for pid in "${!args_of[@]}"; do
    session_in_args "${args_of[$pid]}" || continue
    ancestor=$pid
    for ((hops = 0; hops < 12; hops++)); do
      ancestor=$(parent_pid "$ancestor") || break
      [[ -n $ancestor && $ancestor != 0 && $ancestor != 1 ]] || break
      if [[ -n ${window_of_pid[$ancestor]-} ]]; then
        emit "$found_session" "${window_of_pid[$ancestor]}"
        break
      fi
    done
  done
}

# ---------------------------------------------------------------- listing

# One session's agents and workspaces, from its own server. `--session` is
# left off for the default one: passing it by name would address a *named*
# session that happens to be called "default", which is a different server.
snapshot_for() {
  local name="$1" is_default="$2"
  local out
  if [[ $is_default == true ]]; then
    out=$(herdr api snapshot 2>/dev/null) || return 1
  else
    out=$(herdr --session "$name" api snapshot 2>/dev/null) || return 1
  fi
  [[ -n $out ]] || return 1
  printf '%s' "$out"
}

cmd_list() {
  local sessions_json
  sessions_json=$(herdr session list --json 2>/dev/null) || die "could not reach herdr"
  [[ -n $sessions_json ]] || die "could not reach herdr"

  local windows
  windows=$(window_map || true)

  # The snapshots are collected here rather than in jq, because each one is a
  # separate command. They go in as a name-keyed object, so the merge below is
  # a lookup instead of a search.
  #
  # The object is assembled as text rather than folded together with a jq call
  # per session: this runs every few seconds, and a jq start costs more than
  # everything else in this function put together. The key is safe to splice
  # in unquoted because valid_session_name has already refused anything but
  # letters, digits, dot, dash and underscore.
  # A session that is not running has no server to ask, but it has not
  # forgotten anything either: herdr writes the layout to session.json, and
  # that file still names the workspaces and the directory each one was opened
  # in. Reading it is what makes a stopped row say what it is holding rather
  # than only that it is down - the difference between a session worth starting
  # back up and a name left over from an afternoon.
  local snapshots='' saved='' name is_default running dir snap labels
  while IFS=$'\t' read -r name is_default running dir; do
    [[ -n $name ]] || continue
    valid_session_name "$name" || continue

    if [[ $running == true ]]; then
      snap=$(snapshot_for "$name" "$is_default") || continue
      snapshots+="${snapshots:+,}\"$name\":$snap"
      continue
    fi

    readable_file "$dir/session.json" || continue
    # The label herdr shows is the name a workspace was given, and the last
    # part of the directory it was opened in otherwise - the same two, in the
    # same order, that a running snapshot resolves to its label.
    labels=$(jq -c --arg home "$HOME" '[.workspaces[]?
                     | (.custom_name
                        // (if (.identity_cwd // "") == $home then "~"
                            else (.identity_cwd // "" | split("/") | last) end))
                     | select(. != null and . != "")]
                    | unique' -- "$dir/session.json" 2>/dev/null) || continue
    [[ -n $labels ]] || continue
    saved+="${saved:+,}\"$name\":$labels"
  done < <(printf '%s' "$sessions_json" |
    jq -r '.sessions[]? | "\(.name)\t\(.default // false)\t\(.running // false)\t\(.session_dir // "")"')
  snapshots="{$snapshots}"
  saved="{$saved}"
  printf '%s' "$saved" | jq -e . >/dev/null 2>&1 || saved="{}"
  # A truncated or unparseable reply from any one server must not take the
  # whole list down with it.
  printf '%s' "$snapshots" | jq -e . >/dev/null 2>&1 || snapshots='{}'

  printf '%s' "$sessions_json" | jq -c \
    --argjson snapshots "$snapshots" \
    --argjson saved "$saved" \
    --arg windows "$windows" '
    ($windows | split("\n") | map(select(length > 0) | split("\t"))
      | map({key: .[0], value: .[1]}) | from_entries) as $win
    | [.sessions[]?
       | .name as $name
       | (($snapshots[$name].result.snapshot) // {}) as $snap
       | ($snap.agents // []) as $agents
       # Workspace labels live on the workspace, the agent only carries the id
       # it sits in, so they are joined here rather than in the panel: one
       # place turns what herdr says into what gets drawn.
       | (($snap.workspaces // [])
          | map({key: (.workspace_id // ""), value: (.label // "")})
          | from_entries) as $wslabels
       | {
           name: $name,
           isDefault: (.default // false),
           running: (.running // false),
           version: ($snap.version // ""),
           agents: ($agents | length),
           working: ([$agents[] | select(.agent_status == "working")] | length),
           blocked: ([$agents[] | select(.agent_status == "blocked")] | length),
           idle:    ([$agents[] | select(.agent_status == "idle")] | length),
           done:    ([$agents[] | select(.agent_status == "done")] | length),
           workspaces: (($snap.workspaces // []) | length),
           agentList: ($agents
                       | map({title: (.terminal_title_stripped // .terminal_title // ""),
                              status: (.agent_status // "unknown"),
                              pane: (.pane_id // ""),
                              workspace: ($wslabels[.workspace_id // ""] // ""),
                              # Herdr bumps this every time an agent changes
                              # state. Passed through so the panel can tell
                              # two agents that both want something apart by
                              # which one spoke last.
                              seq: (.state_change_seq // 0)})
                       | map(select(.title != ""))
                       # The attention queue herdr uses itself, the order its
                       # own agent panel takes when agent_panel_sort is set to
                       # priority: what wants an answer, then what finished
                       # unseen, then what is busy, then what is only waiting
                       # for you to type. Sorting is stable in jq, so agents
                       # sharing a state keep the order herdr laid them out in.
                       | sort_by(if   .status == "blocked" then 0
                                 elif .status == "done"    then 1
                                 elif .status == "working" then 2
                                 elif .status == "idle"    then 3
                                 else 4 end)),
           projects: (if (.running // false)
                      then (($snap.workspaces // []) | map(.label // "")
                            | map(select(length > 0)) | unique)
                      else ($saved[$name] // []) end),
           windowAddress: ($win[$name] // "")
         }]
    | sort_by([(if .isDefault then 0 else 1 end),
               (if .running then 0 else 1 end),
               (.name | ascii_downcase)])
    | {ok: true,
       error: "",
       sessions: .,
       running: ([.[] | select(.running)] | length),
       agents: ([.[] | .agents] | add // 0),
       blocked: ([.[] | .blocked] | add // 0),
       done: ([.[] | .done] | add // 0),
       working: ([.[] | .working] | add // 0)}
  ' 2>/dev/null || die "unexpected output from herdr"
}

# ------------------------------------------------------------- open a session

# Bring up the window showing a session, or start one. Returns 0 once
# something has been done, 1 when no terminal could be started.
show_session() {
  local name="$1"

  local address workspace
  IFS=$'\t' read -r address workspace < <(
    window_map | awk -F'\t' -v want="$name" '$1 == want { print $2 "\t" $3; exit }')

  # Both values are spliced into a Lua expression, so they are checked for
  # shape first rather than escaped. A window address is hex; a workspace name
  # is a number, a name, or "special:<name>". Anything else means the window
  # is not what we think it is, and focusing is not worth guessing at.
  if [[ $address =~ ^0x[0-9a-fA-F]+$ ]]; then
    # A window on another workspace stays hidden however hard it is focused:
    # focus picks the window, it does not bring its workspace into view. So
    # switch first, then focus - which also lands on the right monitor when
    # the workspace lives on the other screen.
    if [[ $workspace =~ ^(special:)?[A-Za-z0-9_-]{1,32}$ ]]; then
      hyprctl dispatch "hl.dsp.focus({ workspace = '$workspace' })" >/dev/null 2>&1
    fi
    # Quattro's hyprctl parses its argument as Lua, so `dispatch focuswindow`
    # is a syntax error now. The address is single-quoted inside the Lua call.
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })" >/dev/null 2>&1
    return 0
  fi

  # No window: open one. A numbered session is named after the Hyprland
  # workspace it belongs to, so it is opened there rather than on top of
  # whatever is in front of you - otherwise "Workspace 4" would land on
  # workspace 7 and the name would stop meaning anything.
  if [[ $name =~ ^[0-9]{1,3}$ ]]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = '$name' })" >/dev/null 2>&1
  fi

  # `herdr --session <name>` attaches to the server that is already running
  # under that name and only starts one when there is none, so the same
  # command covers a running session with no window and a stopped one. The
  # session keeps its own state, so the directory only matters the very first
  # time a name is used.
  local -a herdr_cmd=(herdr)
  [[ $name == default ]] || herdr_cmd+=(--session "$name")

  # Foot by name rather than through xdg-terminal-exec: the app id is what
  # window rules and the window matching above key off, and a terminal chosen
  # from the desktop's list is not guaranteed to take one. xdg-terminal-exec
  # stays as the fallback for a machine without foot.
  local -a launch=()
  if command -v uwsm-app >/dev/null 2>&1; then
    launch=(setsid uwsm-app --)
  else
    launch=(setsid)
  fi

  if command -v foot >/dev/null 2>&1; then
    launch+=(foot "--app-id=$APP_ID" "--working-directory=$HOME" -e "${herdr_cmd[@]}")
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    launch+=(xdg-terminal-exec "--app-id=$APP_ID" "--dir=$HOME" -- "${herdr_cmd[@]}")
  else
    return 1
  fi

  "${launch[@]}" >/dev/null 2>&1 &
  disown
  return 0
}

cmd_open() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  show_session "$name" || die "no terminal available"
  printf '{"ok":true}\n'
}

# Land on one agent rather than on whatever the session was last showing.
#
# The pane is focused over the socket first, so the server has already moved
# by the time the window comes up - and it moves even when there is no window
# at all, which is what makes this work on a session that has to be opened.
# `herdr agent focus` switches workspace and tab inside the session on its
# own; the hyprctl half below is only about which window is in front of you.
cmd_focus() {
  local name="${1-}" pane="${2-}"
  valid_session_name "$name" || die "not a session name"
  valid_pane_id "$pane" || die "not a pane id"

  # No `--` before the pane id: herdr does not take one, and valid_pane_id has
  # already refused anything but two runs of letters, digits, dash and
  # underscore around a colon - so nothing here can arrive looking like an
  # option in the first place.
  if [[ $name == default ]]; then
    herdr agent focus "$pane" >/dev/null 2>&1 || true
  else
    herdr --session "$name" agent focus "$pane" >/dev/null 2>&1 || true
  fi

  show_session "$name" || die "no terminal available"
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------ kill / delete

# Which process is serving a session. Every herdr server has the same command
# line - a bare `herdr server`, with no session name on it - so the socket it
# is listening on is the only thing that tells them apart. `ss` is what maps a
# listening unix socket back to the process holding it.
server_pid_for() {
  local socket="$1" pid
  [[ -n $socket ]] || return 1
  pid=$(ss -lpxn 2>/dev/null | awk -v want="$socket " '
    index($0, want) == 0 { next }
    match($0, /pid=[0-9]+/) { print substr($0, RSTART + 4, RLENGTH - 4); exit }')
  [[ $pid =~ ^[0-9]+$ ]] || return 1

  # A pid read out of another tool's output is a pid to check before signalling.
  # It has to still be a herdr server: `ss` was run a moment ago, and a pid that
  # exited since then belongs to whatever was started next.
  local comm=""
  { read -r comm < "/proc/$pid/comm"; } 2>/dev/null || return 1
  [[ $comm == herdr ]] || return 1
  grep -qz server "/proc/$pid/cmdline" 2>/dev/null || return 1

  printf '%s' "$pid"
}

socket_of() {
  herdr session list --json 2>/dev/null |
    jq -r --arg name "$1" '.sessions[]? | select(.name == $name) | .socket_path // ""' 2>/dev/null
}

# How a server is ended here, and the only way. `herdr session stop` asks over
# the socket, so a server too wedged to read that socket never hears it and the
# button looks broken at exactly the moment it is needed. A signal reaches the
# process either way, so there is nothing for the tidy route to be better at.
#
# TERM first and KILL only if that was not enough: a server given the chance to
# close its sockets leaves no stale ones behind, and on a healthy server the
# first signal is all it takes. The default session is killed like any other.
cmd_kill() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"

  local pid
  pid=$(server_pid_for "$(socket_of "$name")") || die "no running server for that session"

  kill -TERM "$pid" 2>/dev/null || true
  local i
  for ((i = 0; i < 10; i++)); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null

  printf '{"ok":true}\n'
}

cmd_delete() {
  local name="${1-}"
  valid_session_name "$name" || die "not a session name"
  [[ $name == default ]] && die "the default session is not deleted from here"
  # No `--` before the name: herdr's argument parser does not take one, and a
  # session name has already been checked against the shape above.
  herdr session delete "$name" >/dev/null 2>&1 || true
  printf '{"ok":true}\n'
}

# ------------------------------------------------------------------- main

require_tools

case "${1:-list}" in
  list) if demo_on; then demo_list; else cmd_list; fi ;;
  # Every write is a no-op while the demo is on, so a click during a shoot
  # cannot reach a real session.
  open) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_open "${1-}"; fi ;;
  focus) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_focus "${1-}" "${2-}"; fi ;;
  kill) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_kill "${1-}"; fi ;;
  delete) shift; if demo_on; then printf '{"ok":true}\n'; else cmd_delete "${1-}"; fi ;;
  demo) shift; cmd_demo "${1-}" ;;
  *) die "unknown command" ;;
esac
